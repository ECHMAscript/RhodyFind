{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "/bin/zsh",
      "runtimeArgs": [
        "-c",
        "export PATH=$HOME/.local/node/bin:$PATH && npx expo start --web --port 8081"
      ],
      "port": 8081
    },
    {
      "name": "web-fast",
      "runtimeExecutable": "/bin/zsh",
      "runtimeArgs": [
        "-c",
        "export PATH=$HOME/.local/node/bin:$PATH && npm run preview:web"
      ],
      "port": 8082
    }
  ]
}
